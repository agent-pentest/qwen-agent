# Create a DashScope key at https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key

# Use a fine-grained, read-only token from https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=replace-with-your-github-token

# Optional settings
QWEN_MODEL=qwen-plus
GITHUB_API_URL=https://api.github.com

